<!--
  Firestrike: Feuerstein auf Stahl.
  Erzeugt aus tokens/firestrike.json (Version 1.2.0) von werkzeuge/marke.py.
  Nicht von Hand ändern, sondern in https://github.com/Celestial0579/firestrike-branding
  Farben heißen nach ihrer Rolle (FsGrundColor, FsGrundBrush …), nie nach dem Farbton.
  In App.xaml nach XamlControlsResources einbinden, damit die Akzentreihe gilt:
    <ResourceDictionary Source="ms-appx:///Themes/Firestrike.xaml" />
  Im Modus Hoher Kontrast zeigen die Rollen auf Systemfarben. Für Oberflächen die
  Brush-Schlüssel nehmen: Sie folgen einem Wechsel des Kontrastdesigns sofort,
  die Color-Schlüssel erst beim nächsten Laden.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Seitengrund, die unterste Ebene -->
      <Color x:Key="FsGrundColor">#EFF0ED</Color>
      <SolidColorBrush x:Key="FsGrundBrush" Color="{StaticResource FsGrundColor}" />
      <!-- Karten und Felder; Schrift auf Stahl und Glut -->
      <Color x:Key="FsFlaecheColor">#FFFFFF</Color>
      <SolidColorBrush x:Key="FsFlaecheBrush" Color="{StaticResource FsFlaecheColor}" />
      <!-- abgesetzte Fläche: Quelltext, Tabellenköpfe, Hervorhebungen -->
      <Color x:Key="FsFlaecheTiefColor">#E3E5E1</Color>
      <SolidColorBrush x:Key="FsFlaecheTiefBrush" Color="{StaticResource FsFlaecheTiefColor}" />
      <!-- Trennlinien und Ränder; nur Schmuck, trägt nie Bedeutung -->
      <Color x:Key="FsLinieColor">#C9CCC6</Color>
      <SolidColorBrush x:Key="FsLinieBrush" Color="{StaticResource FsLinieColor}" />
      <!-- Fließtext -->
      <Color x:Key="FsTextColor">#1B1E1C</Color>
      <SolidColorBrush x:Key="FsTextBrush" Color="{StaticResource FsTextColor}" />
      <!-- Nebensächliches: Datum, Bildunterschrift, Hilfetext -->
      <Color x:Key="FsTextLeiseColor">#5A605B</Color>
      <SolidColorBrush x:Key="FsTextLeiseBrush" Color="{StaticResource FsTextLeiseColor}" />
      <!-- Schaltflächen, ruhige Akzentflächen, Verweis beim Überfahren -->
      <Color x:Key="FsStahlColor">#33414B</Color>
      <SolidColorBrush x:Key="FsStahlBrush" Color="{StaticResource FsStahlColor}" />
      <!-- Überschriften und Wortmarke; eine Textrolle, im dunklen Thema bewusst hell -->
      <Color x:Key="FsStahlTiefColor">#212B33</Color>
      <SolidColorBrush x:Key="FsStahlTiefBrush" Color="{StaticResource FsStahlTiefColor}" />
      <!-- der eine warme Akzent: Linien und Marker; auf hellem Grund nie Text -->
      <Color x:Key="FsFunkeColor">#E8A33D</Color>
      <SolidColorBrush x:Key="FsFunkeBrush" Color="{StaticResource FsFunkeColor}" />
      <!-- Verweise im Fließtext, Schaltfläche beim Überfahren -->
      <Color x:Key="FsGlutColor">#A24C18</Color>
      <SolidColorBrush x:Key="FsGlutBrush" Color="{StaticResource FsGlutColor}" />
      <!-- Tastaturfokus; eigene Rolle, weil der Funke auf hellem Grund zu schwach ist -->
      <Color x:Key="FsFokusColor">#A24C18</Color>
      <SolidColorBrush x:Key="FsFokusBrush" Color="{StaticResource FsFokusColor}" />
      <!-- Akzentreihe aus Glut und Funke, in beiden Themen gleich. Siehe docs/kontraste.md. -->
      <Color x:Key="SystemAccentColor">#A24C18</Color>
      <Color x:Key="SystemAccentColorLight1">#CF6028</Color>
      <Color x:Key="SystemAccentColorLight2">#DB7745</Color>
      <Color x:Key="SystemAccentColorLight3">#F2B558</Color>
      <Color x:Key="SystemAccentColorDark1">#A24C18</Color>
      <Color x:Key="SystemAccentColorDark2">#A24C18</Color>
      <Color x:Key="SystemAccentColorDark3">#7E3B13</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <!-- Seitengrund, die unterste Ebene -->
      <Color x:Key="FsGrundColor">#141715</Color>
      <SolidColorBrush x:Key="FsGrundBrush" Color="{StaticResource FsGrundColor}" />
      <!-- Karten und Felder; Schrift auf Stahl und Glut -->
      <Color x:Key="FsFlaecheColor">#1C201D</Color>
      <SolidColorBrush x:Key="FsFlaecheBrush" Color="{StaticResource FsFlaecheColor}" />
      <!-- abgesetzte Fläche: Quelltext, Tabellenköpfe, Hervorhebungen -->
      <Color x:Key="FsFlaecheTiefColor">#262B27</Color>
      <SolidColorBrush x:Key="FsFlaecheTiefBrush" Color="{StaticResource FsFlaecheTiefColor}" />
      <!-- Trennlinien und Ränder; nur Schmuck, trägt nie Bedeutung -->
      <Color x:Key="FsLinieColor">#38403A</Color>
      <SolidColorBrush x:Key="FsLinieBrush" Color="{StaticResource FsLinieColor}" />
      <!-- Fließtext -->
      <Color x:Key="FsTextColor">#E8EBE7</Color>
      <SolidColorBrush x:Key="FsTextBrush" Color="{StaticResource FsTextColor}" />
      <!-- Nebensächliches: Datum, Bildunterschrift, Hilfetext -->
      <Color x:Key="FsTextLeiseColor">#A5ADA6</Color>
      <SolidColorBrush x:Key="FsTextLeiseBrush" Color="{StaticResource FsTextLeiseColor}" />
      <!-- Schaltflächen, ruhige Akzentflächen, Verweis beim Überfahren -->
      <Color x:Key="FsStahlColor">#7E93A1</Color>
      <SolidColorBrush x:Key="FsStahlBrush" Color="{StaticResource FsStahlColor}" />
      <!-- Überschriften und Wortmarke; eine Textrolle, im dunklen Thema bewusst hell -->
      <Color x:Key="FsStahlTiefColor">#B4C6D1</Color>
      <SolidColorBrush x:Key="FsStahlTiefBrush" Color="{StaticResource FsStahlTiefColor}" />
      <!-- der eine warme Akzent: Linien und Marker; auf hellem Grund nie Text -->
      <Color x:Key="FsFunkeColor">#F2B558</Color>
      <SolidColorBrush x:Key="FsFunkeBrush" Color="{StaticResource FsFunkeColor}" />
      <!-- Verweise im Fließtext, Schaltfläche beim Überfahren -->
      <Color x:Key="FsGlutColor">#DB7745</Color>
      <SolidColorBrush x:Key="FsGlutBrush" Color="{StaticResource FsGlutColor}" />
      <!-- Tastaturfokus; eigene Rolle, weil der Funke auf hellem Grund zu schwach ist -->
      <Color x:Key="FsFokusColor">#F2B558</Color>
      <SolidColorBrush x:Key="FsFokusBrush" Color="{StaticResource FsFokusColor}" />
      <!-- Akzentreihe aus Glut und Funke, in beiden Themen gleich. Siehe docs/kontraste.md. -->
      <Color x:Key="SystemAccentColor">#A24C18</Color>
      <Color x:Key="SystemAccentColorLight1">#CF6028</Color>
      <Color x:Key="SystemAccentColorLight2">#DB7745</Color>
      <Color x:Key="SystemAccentColorLight3">#F2B558</Color>
      <Color x:Key="SystemAccentColorDark1">#A24C18</Color>
      <Color x:Key="SystemAccentColorDark2">#A24C18</Color>
      <Color x:Key="SystemAccentColorDark3">#7E3B13</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <!-- Jede Rolle auf eine Systemfarbe. Die Akzentreihe bleibt die des Systems. -->
      <StaticResource x:Key="FsGrundColor" ResourceKey="SystemColorWindowColor" />
      <SolidColorBrush x:Key="FsGrundBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <StaticResource x:Key="FsFlaecheColor" ResourceKey="SystemColorWindowColor" />
      <SolidColorBrush x:Key="FsFlaecheBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <StaticResource x:Key="FsFlaecheTiefColor" ResourceKey="SystemColorWindowColor" />
      <SolidColorBrush x:Key="FsFlaecheTiefBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <StaticResource x:Key="FsLinieColor" ResourceKey="SystemColorWindowTextColor" />
      <SolidColorBrush x:Key="FsLinieBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <StaticResource x:Key="FsTextColor" ResourceKey="SystemColorWindowTextColor" />
      <SolidColorBrush x:Key="FsTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <StaticResource x:Key="FsTextLeiseColor" ResourceKey="SystemColorWindowTextColor" />
      <SolidColorBrush x:Key="FsTextLeiseBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <StaticResource x:Key="FsStahlColor" ResourceKey="SystemColorWindowTextColor" />
      <SolidColorBrush x:Key="FsStahlBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <StaticResource x:Key="FsStahlTiefColor" ResourceKey="SystemColorWindowTextColor" />
      <SolidColorBrush x:Key="FsStahlTiefBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <StaticResource x:Key="FsFunkeColor" ResourceKey="SystemColorHighlightColor" />
      <SolidColorBrush x:Key="FsFunkeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <StaticResource x:Key="FsGlutColor" ResourceKey="SystemColorHotlightColor" />
      <SolidColorBrush x:Key="FsGlutBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <StaticResource x:Key="FsFokusColor" ResourceKey="SystemColorHighlightColor" />
      <SolidColorBrush x:Key="FsFokusBrush" Color="{ThemeResource SystemColorHighlightColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Kanten bleiben Kanten: die Radien von Fluent auf 0. -->
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>
  <!-- Tastaturfokus: durchgezogen, mit Abstand. -->
  <Thickness x:Key="FsFocusThickness">2</Thickness>
  <Thickness x:Key="FsFocusOffset">2</Thickness>
  <!-- Nur Systemschriften, es wird nichts ausgeliefert. -->
  <FontFamily x:Key="FsFontSerif">Palatino Linotype, Book Antiqua, Georgia</FontFamily>
  <FontFamily x:Key="FsFontSans">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FsFontMono">Cascadia Mono, Consolas</FontFamily>
  <!-- Schriftgrößen und Abstände in Pixeln (1rem = 16 px). Apps nehmen die feste Größe. -->
  <x:Double x:Key="FsGroesseKlein">14</x:Double>
  <x:Double x:Key="FsGroesseNormal">17</x:Double>
  <x:Double x:Key="FsGroesseGross">24</x:Double>
  <x:Double x:Key="FsGroesseSehrGross">35.2</x:Double>
  <x:Double x:Key="FsGroesseTitel">48</x:Double>
  <x:Double x:Key="FsAbstand10">5.6</x:Double>
  <x:Double x:Key="FsAbstand20">11.2</x:Double>
  <x:Double x:Key="FsAbstand30">17.6</x:Double>
  <x:Double x:Key="FsAbstand40">27.2</x:Double>
  <x:Double x:Key="FsAbstand50">41.6</x:Double>
  <x:Double x:Key="FsAbstand60">64</x:Double>
  <x:Double x:Key="FsAbstand70">96</x:Double>
  <!-- Zeilenhöhen als Faktor der Schriftgröße, Stärke der Überschriften. -->
  <x:Double x:Key="FsZeilenhoeheText">1.65</x:Double>
  <x:Double x:Key="FsZeilenhoeheUeberschrift">1.2</x:Double>
  <FontWeight x:Key="FsStaerkeUeberschrift">SemiBold</FontWeight>
</ResourceDictionary>
